        function updateSettings(type) {
            const langSelect = document.getElementById('lang-select');
            const currSelect = document.getElementById('curr-select');
            const tempSelect = document.getElementById('temp-select');
            const lang = langSelect.value;
            const selectedLangOption = langSelect.options[langSelect.selectedIndex];
            document.getElementById('lang-icon').innerText = selectedLangOption.getAttribute('data-flag');
            document.getElementById('curr-icon').innerText = currSelect.value;
            document.getElementById('temp-icon').innerText = tempSelect.value;
            const allLangs = ['it', 'en', 'fr'];
            allLangs.forEach(l => {
                const elements = document.getElementsByClassName('lang-' + l);
                for (let el of elements) {
                    el.style.display = (l === lang) ? 'inline-block' : 'none';
                }
            });
            const allOptions = document.querySelectorAll('option[data-' + lang + ']');
