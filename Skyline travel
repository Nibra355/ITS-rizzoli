                it: { dest: "Dove vuoi andare?", peop: "Quante persone?" },
                en: { dest: "Where do you want to go?", peop: "How many people?" },
                fr: { dest: "Où voulez vous aller?", peop: "Combien de personnes?" }
            };
            destInput.placeholder = placeholders[lang].dest;
            peopleInput.placeholder = placeholders[lang].peop;
            const targetIcon = document.getElementById(type + '-icon');
            if (targetIcon) {
                targetIcon.style.transform = 'scale(1.3)';
                setTimeout(() => targetIcon.style.transform = 'scale(1)', 200);
            }
        }
